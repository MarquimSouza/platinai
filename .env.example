# Platinai — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA coloque valores reais aqui: este arquivo vai pro GitHub. O .env.local fica de fora do git.
# Em produção, as mesmas variáveis precisam estar no painel do Vercel
# (Settings → Environment Variables) — e depois de adicionar/alterar, é preciso fazer um Redeploy.

# --- Auth (next-auth) ---
# Local: http://localhost:3000 | Produção: o domínio real (ex: https://platinai.vercel.app)
NEXTAUTH_URL=http://localhost:3000
# String aleatória longa (ex: gerada com: openssl rand -base64 32)
NEXTAUTH_SECRET=

# --- Steam ---
# Steam Web API key (steamcommunity.com/dev/apikey)
STEAM_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor (rotas de API). Nunca expor ao navegador nem prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Busca na web ---
# Texto do guia (tavily.com)
TAVILY_API_KEY=
# Vídeo (Google Cloud Console → YouTube Data API v3)
YOUTUBE_API_KEY=

# --- IA para gerar as dicas ---
# Principal (Google AI Studio)
GEMINI_API_KEY=
# Fallback quando o Gemini falha (console.groq.com/keys) — opcional, sem ela não há fallback
GROQ_API_KEY=
# Opcional: troca o modelo do Groq sem mexer no código (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=

# --- Capas de jogos (opcional) ---
# Fallback de capa (steamgriddb.com)
STEAMGRIDDB_API_KEY=
